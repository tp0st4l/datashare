# Modèle du fichier .env : copier en .env, ou lancer scripts/install.sh qui le génère.
# Valeurs sans $, guillemets ni antislash. Pour générer un secret : openssl rand -hex 32

# Administrateur PostgreSQL : superutilisateur, réservé à l'administration
DB_ADMIN_USER=datashare_admin
DB_ADMIN_PASSWORD=<secret>

# Compte utilisé par l'application : droits limités à la base DB_NAME
# (doit être différent de DB_ADMIN_USER)
DB_USER=datashare_app
DB_PASSWORD=<secret>
DB_NAME=datashare

# Clé de signature des JWT
JWT_SECRET=<secret>